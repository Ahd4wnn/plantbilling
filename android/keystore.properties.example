# Copy this file to  keystore.properties  (same folder) and fill in real values.
# keystore.properties is git-ignored and must NEVER be committed.
#
# Generate the upload keystore ONCE with (run from the android/ folder):
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias plantbill-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Then set the four values below to match what you entered.
# BACK UP upload-keystore.jks AND these passwords somewhere safe — if you lose
# them you can never publish an update to the same app again.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=plantbill-upload
keyPassword=CHANGE_ME
